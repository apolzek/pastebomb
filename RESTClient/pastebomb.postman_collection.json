{
  "info": {
    "name": "pastebomb",
    "description": "pastebomb HTTP API. Set baseUrl, then run Login: it stores the bearer token in a collection variable that every authenticated request reuses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ownedSlug",
      "value": ""
    },
    {
      "key": "anonymousSlug",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "Checks the database, so an unhealthy instance is pulled out of the load balancer."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"john\",\n    \"email\": \"john@example.com\",\n    \"username\": \"john\",\n    \"born_date\": \"1990-09-04\",\n    \"password\": \"a-long-enough-password\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"john@example.com\",\n    \"password\": \"a-long-enough-password\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "}",
                  "pm.test('a token was issued', () => pm.expect(body.data.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"John Doe\",\n    \"username\": \"john.doe\",\n    \"email\": \"john.doe@example.com\",\n    \"born_date\": \"1990-09-04\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Public profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/u/john",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "john"
              ]
            },
            "description": "Unauthenticated, so it returns only the id, name, username and creation date."
          },
          "response": []
        },
        {
          "name": "Deactivate my account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pastes",
      "item": [
        {
          "name": "Create an owned paste",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/me/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "me",
                "post"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"deploy notes\",\n    \"content\": \"kubectl rollout status deploy/api\",\n    \"category\": \"ops\",\n    \"is_public\": false\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.url_id) {",
                  "    pm.collectionVariables.set('ownedSlug', body.data.url_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create an anonymous paste",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/anonymous/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "anonymous",
                "post"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"one time notes\",\n    \"content\": \"this disappears on its own\",\n    \"category\": \"notes\",\n    \"expiration_date\": \"2030-12-31T23:59:59Z\",\n    \"secret_access\": \"open sesame\"\n}"
            },
            "description": "expiration_date is RFC3339 and must be in the future. secret_access is optional and is stored hashed."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.url_id) {",
                  "    pm.collectionVariables.set('anonymousSlug', body.data.url_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read a paste",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Post-Secret",
                "value": "open sesame"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/anonymous/{{anonymousSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "anonymous",
                "{{anonymousSlug}}"
              ]
            },
            "description": "Pastes are addressed by their random handle only. Numeric ids never resolve."
          },
          "response": []
        },
        {
          "name": "Read a paste raw",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Post-Secret",
                "value": "open sesame"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/anonymous/{{anonymousSlug}}/raw",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "anonymous",
                "{{anonymousSlug}}",
                "raw"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Public index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/u/anonymous/posts?page=1&per_page=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "anonymous",
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            },
            "description": "Metadata only: bodies are never part of the index."
          },
          "response": []
        },
        {
          "name": "My pastes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/me/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "me",
                "posts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "My pastes with bodies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/me/posts/content",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "me",
                "posts",
                "content"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Administrative",
      "description": "Needs a token whose admin claim is true. Grant it with: UPDATE users SET is_admin = 1 WHERE email = '...'; then log in again.",
      "item": [
        {
          "name": "All accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/all?page=1&per_page=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "all"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Active accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Active accounts paginated",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/u/paginate?page=1&per_page=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "u",
                "paginate"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "12"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
