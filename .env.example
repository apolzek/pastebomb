# Copy to .env and fill in real values. Never commit the resulting file.

# HTTP
APP_PORT=":8000"
# Comma-separated list of origins allowed to call the API from a browser.
# "*" disables the origin check entirely and should stay out of production.
CORS_ALLOWED_ORIGINS="http://localhost:8080"
# Comma-separated proxy addresses whose X-Forwarded-For header may be trusted.
# Leave empty when the service is exposed directly: the rate limiter keys on
# the client IP, and trusting a forged header would let anyone bypass it.
HTTP_TRUSTED_PROXIES=""

# Database
DB_DRIVER="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="pastebomb"
DB_USER="user"
DB_PASSWORD="change-this-database-password"

# Security
# Required, at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=""
JWT_ISSUER="pastebomb"
JWT_TTL="24h"
# Cost of the bcrypt work factor, between 10 and 15.
BCRYPT_COST="12"
# Directory the audit trail is written to.
AUDIT_LOG_DIR="."

# Rate limits, per client IP. The defaults are production values; raise them
# only in a benchmark environment (see loadtest/docker-compose.loadtest.yaml).
# Public reads are limited because reading a secret-protected paste costs a
# bcrypt comparison, about 250 times an ordinary read, on a route that needs no
# credential.
RATE_LIMIT_LOGIN_RPS="0.2"
RATE_LIMIT_LOGIN_BURST="5"
RATE_LIMIT_ANON_RPS="1"
RATE_LIMIT_ANON_BURST="10"
RATE_LIMIT_READ_RPS="50"
RATE_LIMIT_READ_BURST="100"

# Background jobs
PURGE_INTERVAL="1m"

# Logging: "debug" or unset for info level.
LOG_LEVEL=""
